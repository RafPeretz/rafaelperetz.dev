# ─── Site ────────────────────────────────────────────────────────────────
# Canonical origin. Leave empty until the custom domain is live; Vercel's
# VERCEL_PROJECT_PRODUCTION_URL is used as a fallback automatically.
NEXT_PUBLIC_SITE_URL=

# ─── Contact form (Resend) ───────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
# Where contact-form submissions are delivered. Until rafaelperetz.dev is
# verified in Resend, this must be the email address of your Resend account.
CONTACT_TO_EMAIL=
# Sender. Before domain verification use: Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────
# https://console.upstash.com — optional locally (rate limiting is skipped
# with a warning when unset), required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
